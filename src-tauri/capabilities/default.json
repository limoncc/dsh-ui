{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local pages capability for dsh-ui (loading/bar/index)",
  "windows": ["main"],
  "webviews": ["content", "bar"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "shell:allow-open",
    "window-state:default"
  ]
}
