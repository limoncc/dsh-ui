{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "loopback",
  "description": "Capability for the remote dsh web page served on loopback",
  "windows": ["main"],
  "webviews": ["content"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-set-webview-zoom"
  ]
}
